{
    "toolchain": {
        "lto": "full",
        "defaultOpt": "Oz",
        "march": {
            "aarch64": "armv8-a",
            "x86_64": "x86-64-v2"
        },
        "commonCflags": [
            "-fPIC",
            "-ffunction-sections",
            "-fdata-sections",
            "-fno-ident",
            "-fmerge-all-constants"
        ],
        "commonLdflags": [
            "-Wl,-O2",
            "-Wl,--gc-sections",
            "-Wl,--icf=safe"
        ],
        "systems": {
            "linux": {
                "cflags": [
                    "-fno-semantic-interposition",
                    "-fvisibility=hidden"
                ],
                "cxxflags": [
                    "-fvisibility-inlines-hidden"
                ],
                "ldflags": [
                    "-Wl,--lto-O2"
                ]
            },
            "android": {
                "cflags": [
                    "-fno-semantic-interposition",
                    "-fvisibility=hidden"
                ],
                "cxxflags": [
                    "-fvisibility-inlines-hidden",
                    "-static-libstdc++"
                ],
                "ldflags": [
                    "-Wl,--lto-O2",
                    "-Wl,-z,max-page-size=16384",
                    "-Wl,--pack-dyn-relocs=android+relr"
                ]
            },
            "windows": {
                "cflags": [
                    "-D_WIN32_WINNT=0x0A00",
                    "-DWINVER=0x0A00",
                    "-DLIBXML_STATIC"
                ],
                "cxxflags": [
                    "-static-libstdc++"
                ],
                "ldflags": [
                    "-static"
                ]
            }
        }
    },
    "optimizationTiers": {
        "zlib-ng": "O3",
        "dav1d": "O3",
        "ffmpeg": "O2",
        "libass": "O2",
        "libplacebo": "O2",
        "mpv": "O2",
        "freetype": "Oz",
        "fribidi": "Oz",
        "harfbuzz": "Oz",
        "libunibreak": "Oz",
        "libxml2": "Oz",
        "fontconfig": "Oz",
        "shaderc": "Oz",
        "spirv-cross": "Oz",
        "uchardet": "Oz",
        "win-iconv": "Oz",
        "libiconv": "Oz",
        "wayland": "Oz",
        "wayland-protocols": "Oz",
        "vulkan-headers": "Oz"
    },
    "staticPackages": [
        "libavcodec",
        "libavfilter",
        "libavformat",
        "libavutil",
        "libswresample",
        "libswscale",
        "libass",
        "libplacebo",
        "freetype2",
        "harfbuzz",
        "fribidi",
        "libunibreak",
        "fontconfig",
        "libxml-2.0",
        "zlib",
        "zlib-ng",
        "dav1d",
        "shaderc",
        "shaderc_combined",
        "spirv-cross-c-shared",
        "spirv-cross-c",
        "uchardet",
        "iconv",
        "libiconv",
        "ffnvcodec"
    ],
    "recipes": {
        "zlib-ng": [
            "-DZLIB_COMPAT=ON",
            "-DWITH_GTEST=OFF",
            "-DINSTALL_UTILS=OFF",
            "-DWITH_OPTIM=ON"
        ],
        "dav1d": [
            "enable_tests=false",
            "enable_tools=false",
            "stack_alignment=16"
        ],
        "freetype": [
            "zlib=enabled",
            "bzip2=disabled",
            "png=disabled",
            "harfbuzz=disabled",
            "brotli=disabled"
        ],
        "fribidi": [
            "tests=false",
            "docs=false"
        ],
        "harfbuzz": [
            "auto_features=disabled",
            "tests=disabled",
            "docs=disabled",
            "utilities=disabled",
            "glib=disabled",
            "gobject=disabled",
            "icu=disabled",
            "introspection=disabled",
            "freetype=enabled",
            "raster=disabled",
            "vector=disabled",
            "gpu=disabled",
            "subset=disabled"
        ],
        "libxml2": [
            "minimum=true",
            "push=enabled",
            "reader=enabled",
            "sax1=enabled",
            "iso8859x=enabled",
            "pattern=enabled"
        ],
        "fontconfig": {
            "common": [
                "tests=disabled",
                "doc=disabled",
                "tools=disabled",
                "nls=disabled",
                "cache-build=disabled",
                "tests-external-fonts=disabled",
                "xml-backend=libxml2"
            ],
            "linux": [
                "baseconfig-dir=/etc/fonts",
                "config-dir=/etc/fonts/conf.d",
                "template-dir=/usr/share/fontconfig/conf.avail",
                "cache-dir=/var/cache/fontconfig"
            ],
            "android": [
                "default-fonts-dirs=/system/fonts",
                "additional-fonts-dirs=/system/fonts",
                "baseconfig-dir=/system/etc/fonts",
                "config-dir=/system/etc/fonts/conf.d",
                "template-dir=/system/etc/fonts/conf.avail",
                "cache-dir=/nonexistent/fontconfig"
            ]
        },
        "libass": [
            "--enable-asm"
        ],
        "uchardet": [
            "-DBUILD_SHARED_LIBS=OFF",
            "-DBUILD_STATIC=ON",
            "-DBUILD_BINARY=OFF",
            "-DCHECK_SSE2=ON"
        ],
        "win-iconv": [
            "-DWIN_ICONV_BUILD_STATIC=ON",
            "-DWIN_ICONV_BUILD_SHARED=OFF",
            "-DWIN_ICONV_BUILD_EXECUTABLE=OFF",
            "-DWIN_ICONV_BUILD_TEST=OFF"
        ],
        "libiconv": [
            "--disable-nls",
            "--enable-extra-encodings",
            "--disable-rpath",
            "--without-libintl-prefix"
        ],
        "wayland": [
            "libraries=true",
            "scanner=true",
            "tests=false",
            "documentation=false",
            "dtd_validation=false"
        ],
        "wayland-protocols": [
            "tests=false"
        ],
        "vulkan-headers": [
            "-DVULKAN_HEADERS_ENABLE_TESTS=OFF",
            "-DVULKAN_HEADERS_ENABLE_INSTALL=ON"
        ],
        "shaderc": [
            "-DSHADERC_SKIP_TESTS=ON",
            "-DSHADERC_SKIP_EXAMPLES=ON",
            "-DSHADERC_SKIP_EXECUTABLES=ON",
            "-DSHADERC_SKIP_COPYRIGHT_CHECK=ON",
            "-DSHADERC_SKIP_INSTALL=OFF",
            "-DSHADERC_ENABLE_WERROR_COMPILE=OFF",
            "-DSHADERC_ENABLE_HLSL=OFF",
            "-DENABLE_HLSL=OFF",
            "-DENABLE_PCH=OFF",
            "-DSPIRV_SKIP_TESTS=ON",
            "-DSPIRV_SKIP_EXECUTABLES=ON",
            "-DENABLE_GLSLANG_BINARIES=OFF",
            "-DENABLE_SPVREMAPPER=OFF",
            "-DSPIRV_TOOLS_BUILD_STATIC=ON"
        ],
        "spirv-cross": [
            "-DSPIRV_CROSS_STATIC=ON",
            "-DSPIRV_CROSS_SHARED=OFF",
            "-DSPIRV_CROSS_CLI=OFF",
            "-DSPIRV_CROSS_ENABLE_TESTS=OFF",
            "-DSPIRV_CROSS_ENABLE_C_API=ON",
            "-DSPIRV_CROSS_ENABLE_MSL=OFF",
            "-DSPIRV_CROSS_ENABLE_CPP=OFF",
            "-DSPIRV_CROSS_ENABLE_REFLECT=OFF",
            "-DSPIRV_CROSS_ENABLE_UTIL=OFF"
        ],
        "libplacebo": {
            "common": [
                "auto_features=disabled",
                "opengl=enabled",
                "dovi=enabled",
                "demos=false",
                "tests=false",
                "bench=false"
            ],
            "windows": [
                "d3d11=enabled",
                "shaderc=enabled"
            ]
        },
        "mpv": [
            "auto_features=disabled",
            "libmpv=true",
            "cplayer=false",
            "tests=false",
            "fuzzers=false",
            "build-date=false",
            "lua=disabled",
            "gl=enabled",
            "plain-gl=enabled",
            "zlib=enabled",
            "vector=enabled"
        ]
    },
    "patches": {
        "freetypeDisabledModules": [
            "FONT_MODULES += type1",
            "FONT_MODULES += cid",
            "FONT_MODULES += hvf",
            "FONT_MODULES += pfr",
            "FONT_MODULES += type42",
            "FONT_MODULES += winfonts",
            "FONT_MODULES += pcf",
            "FONT_MODULES += bdf",
            "RASTER_MODULES += svg",
            "RASTER_MODULES += sdf",
            "AUX_MODULES += lzw",
            "AUX_MODULES += bzip2",
            "BASE_EXTENSIONS += ftbdf.c",
            "BASE_EXTENSIONS += ftcid.c",
            "BASE_EXTENSIONS += ftpfr.c",
            "BASE_EXTENSIONS += ftwinfnt.c"
        ],
        "mpvWaylandCompat": [
            {
                "file": "video/out/wayland_common.c",
                "old": "wl_display_create_queue_with_name(wl->display, \"image description info queue\")",
                "new": "wl_display_create_queue(wl->display)"
            },
            {
                "file": "video/out/wayland_common.c",
                "old": "wl_display_create_queue_with_name(wl->display, \"image description creator queue\")",
                "new": "wl_display_create_queue(wl->display)"
            }
        ]
    },
